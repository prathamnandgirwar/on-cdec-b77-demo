pipeline {
    agent any 
    stages {
        stage ("pull"){
            steps {
              git branch:'main',url: 'https://github.com/prathamnandgirwar/on-cdec-b77-demo.git'
            }
        }
           stage ("build"){
            steps {
                echo "code build successfully"
            }
        }
           stage ("test"){
            steps {
                echo "code test successfully"
            }
        }
           stage ("deploy"){
            steps {
                echo "code deploy successfully"
            }
        }
    }
}
